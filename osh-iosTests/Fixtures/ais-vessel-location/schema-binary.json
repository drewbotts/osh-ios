{
  "obsFormat": "application/swe+binary",
  "recordSchema": {
    "type": "DataRecord",
    "name": "vesselLocation",
    "definition": "http://sensorml.com/ont/swe/property/VesselLocation",
    "label": "Vessel Location",
    "description": "Unified AIS vessel location — types 1/2/3 (Class A) and 18/19 (Class B). rot, roti, and smi are Class A only; Class B records carry 0/empty values for those fields.",
    "fields": [
      {
        "type": "Time",
        "name": "samplingTime",
        "definition": "SampleTime",
        "label": "Sample Time",
        "description": "Time data was received",
        "referenceFrame": "http://www.opengis.net/def/trs/BIPM/0/UTC",
        "uom": {
          "href": "http://www.opengis.net/def/uom/ISO-8601/0/Gregorian"
        }
      },
      {
        "type": "Category",
        "name": "messageId",
        "definition": "http://sensorml.com/ont/swe/property/MessageId",
        "label": "Message Id",
        "description": "AIS Message Identifier"
      },
      {
        "type": "Text",
        "name": "reportDescription",
        "definition": "http://sensorml.com/ont/swe/property/ReportDescription",
        "label": "Report Description",
        "description": "Describes the report based on the Message Id provided"
      },
      {
        "type": "Count",
        "name": "repeat",
        "definition": "http://sensorml.com/ont/swe/property/repeat",
        "label": "Repeat Indicator",
        "description": "Used by the repeater to indicate how many times a message has been repeated; 0-3; 0 = default"
      },
      {
        "type": "Text",
        "name": "mmsi",
        "definition": "http://sensorml.com/ont/swe/property/Mmsi",
        "label": "MMSI Number",
        "description": "MMSI Number"
      },
      {
        "type": "Quantity",
        "name": "sog",
        "definition": "http://sensorml.com/ont/swe/property/SpeedOverGround",
        "label": "Speed Over Ground",
        "description": "Speed over ground in knots (0–102.2 knots; 102.3 = not available)",
        "uom": {
          "code": "[kn_i]"
        }
      },
      {
        "type": "Boolean",
        "name": "positionAccuracy",
        "definition": "http://sensorml.com/ont/swe/property/PositionAccuracy",
        "label": "Position Accuracy",
        "description": "true = high (<=10 m); false = low (>10 m) = default"
      },
      {
        "type": "Vector",
        "name": "location",
        "definition": "http://sensorml.com/ont/swe/property/LocationVector",
        "label": "Location",
        "referenceFrame": "http://www.opengis.net/def/crs/EPSG/0/4326",
        "coordinates": [
          {
            "type": "Quantity",
            "name": "lat",
            "definition": "http://sensorml.com/ont/swe/property/GeodeticLatitude",
            "label": "Geodetic Latitude",
            "axisID": "Lat",
            "uom": {
              "code": "deg"
            }
          },
          {
            "type": "Quantity",
            "name": "lon",
            "definition": "http://sensorml.com/ont/swe/property/Longitude",
            "label": "Longitude",
            "axisID": "Lon",
            "uom": {
              "code": "deg"
            }
          }
        ]
      },
      {
        "type": "Quantity",
        "name": "cog",
        "definition": "http://sensorml.com/ont/swe/property/CourseOverGround",
        "label": "Course Over Ground",
        "description": "Course over ground in tenths of a degree (0–359.9); 360 = not available = default",
        "uom": {
          "code": "deg"
        }
      },
      {
        "type": "Quantity",
        "name": "heading",
        "definition": "http://sensorml.com/ont/swe/property/TrueHeading",
        "label": "True Heading",
        "description": "Degrees (0–359); 511 = not available = default",
        "uom": {
          "code": "deg"
        }
      },
      {
        "type": "Count",
        "name": "utcSecond",
        "definition": "http://sensorml.com/ont/swe/property/UtcSecond",
        "label": "UTC Second",
        "description": "UTC second when report was generated by the EPFS (0-59); 60 = not available (default); 61 = manual input mode; 62 = dead reckoning mode; 63 = positioning system inoperative",
        "nilValues": [
          {
            "reason": "http://www.opengis.net/def/nil/OGC/0/unknown",
            "value": "60"
          },
          {
            "reason": "http://www.opengis.net/def/nil/OGC/0/inapplicable",
            "value": "61"
          },
          {
            "reason": "http://www.opengis.net/def/nil/OGC/0/inapplicable",
            "value": "62"
          },
          {
            "reason": "http://www.opengis.net/def/nil/OGC/0/missing",
            "value": "63"
          }
        ]
      },
      {
        "type": "Boolean",
        "name": "raim",
        "definition": "http://sensorml.com/ont/swe/property/Raim",
        "label": "Receiver Autonomous Integrity Monitoring",
        "description": "false = RAIM not in use; true = RAIM in use"
      },
      {
        "type": "Quantity",
        "name": "rot",
        "definition": "http://sensorml.com/ont/swe/property/RateOfTurn",
        "label": "Rate of Turn",
        "description": "Rate of turn: (-) = turning left, (+) = turning right; null = not available; ±10 = >±10 deg/min (no TI)",
        "uom": {
          "code": "deg/min"
        }
      },
      {
        "type": "Text",
        "name": "roti",
        "definition": "http://sensorml.com/ont/swe/property/RateOfTurnIndicator",
        "label": "Rate of Turn Indicator",
        "description": "Indicates whether an external Rate of Turn Indicator is available"
      },
      {
        "type": "Text",
        "name": "smi",
        "definition": "http://sensorml.com/ont/swe/property/SpecialManeuverIndicator",
        "label": "Special Maneuver Indicator",
        "description": "Special Maneuver Indicator per ITU-R M.1371-5"
      },
      {
        "type": "Text",
        "name": "navStatus",
        "definition": "http://sensorml.com/ont/swe/property/NavigationalStatus",
        "label": "Navigational Status",
        "description": "Navigational status per ITU-R M.1371-5 Table 3"
      }
    ]
  },
  "recordEncoding": {
    "type": "BinaryEncoding",
    "byteOrder": "bigEndian",
    "byteEncoding": "raw",
    "members": [
      {
        "type": "Component",
        "ref": "/samplingTime",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/messageId",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/string-utf-8"
      },
      {
        "type": "Component",
        "ref": "/reportDescription",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/string-utf-8"
      },
      {
        "type": "Component",
        "ref": "/repeat",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/signedInt"
      },
      {
        "type": "Component",
        "ref": "/mmsi",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/string-utf-8"
      },
      {
        "type": "Component",
        "ref": "/sog",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/positionAccuracy",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/boolean"
      },
      {
        "type": "Component",
        "ref": "/location/lat",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/location/lon",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/cog",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/heading",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/utcSecond",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/signedInt"
      },
      {
        "type": "Component",
        "ref": "/raim",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/boolean"
      },
      {
        "type": "Component",
        "ref": "/rot",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/roti",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/string-utf-8"
      },
      {
        "type": "Component",
        "ref": "/smi",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/string-utf-8"
      },
      {
        "type": "Component",
        "ref": "/navStatus",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/string-utf-8"
      }
    ]
  }
}