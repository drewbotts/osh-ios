{
  "obsFormat": "application/swe+binary",
  "recordSchema": {
    "type": "DataRecord",
    "name": "kraken_doa",
    "definition": "http://sensorml.com/ont/swe/property/doaOutput",
    "label": "DoA",
    "description": "This is the DoA output for the krakenSDR",
    "fields": [
      {
        "type": "Time",
        "name": "time",
        "definition": "http://www.opengis.net/def/property/OGC/0/SamplingTime",
        "label": "KrakenSDR Collection Time",
        "description": "Timestamp of when KrakenSDR reading was generated",
        "referenceFrame": "http://www.opengis.net/def/trs/BIPM/0/UTC",
        "uom": {
          "href": "http://www.opengis.net/def/uom/ISO-8601/0/Gregorian"
        }
      },
      {
        "type": "Quantity",
        "name": "raw_lob",
        "definition": "http://sensorml.com/ont/swe/property/AzimuthAngle",
        "label": "Raw LOB",
        "description": "The LOB to the emitter in absolute (true north) value",
        "uom": {
          "code": "deg"
        }
      },
      {
        "type": "Quantity",
        "name": "confidence",
        "definition": "http://sensorml.com/ont/swe/property/ConfidenceValue",
        "label": "Confidence",
        "description": "Confidence Value (0-99). The higher the better",
        "uom": {
          "href": "http://qudt.org/vocab/unit/UNITLESS"
        }
      },
      {
        "type": "Quantity",
        "name": "rssi",
        "definition": "http://qudt.org/vocab/quantitykind/SignalStrength",
        "label": "RSSI",
        "description": "Received Signal Strength Indicator value of the event",
        "uom": {
          "code": "dB"
        }
      },
      {
        "type": "Quantity",
        "name": "frequency",
        "definition": "http://qudt.org/vocab/quantitykind/Frequency",
        "label": "Frequency",
        "description": "The transmission frequency of the event in Hertz",
        "uom": {
          "code": "Hz"
        }
      },
      {
        "type": "Quantity",
        "name": "time-delta",
        "definition": "http://sensorml.com/ont/swe/property/Latency",
        "label": "Latency",
        "description": "Latency in ms : (Time from signal arrival at antenna, to result. NOT including network latency.)",
        "uom": {
          "code": "ms"
        }
      },
      {
        "type": "Text",
        "name": "uuid",
        "definition": "http://sensorml.com/ont/swe/property/Identifier",
        "label": "UUID",
        "description": "Name of the KrakenSDR station inputted in the Station Information box in the Web GUI"
      },
      {
        "type": "Vector",
        "name": "location",
        "definition": "http://sensorml.com/ont/swe/property/LocationVector",
        "label": "Location",
        "description": "Lat and Long of the Kraken's Position",
        "referenceFrame": "http://www.opengis.net/def/crs/EPSG/0/4326",
        "coordinates": [
          {
            "type": "Quantity",
            "name": "lat",
            "definition": "http://sensorml.com/ont/swe/property/GeodeticLatitude",
            "label": "Geodetic Latitude",
            "axisID": "Lat",
            "uom": {
              "code": "deg"
            }
          },
          {
            "type": "Quantity",
            "name": "lon",
            "definition": "http://sensorml.com/ont/swe/property/Longitude",
            "label": "Longitude",
            "axisID": "Lon",
            "uom": {
              "code": "deg"
            }
          }
        ]
      }
    ]
  },
  "recordEncoding": {
    "type": "BinaryEncoding",
    "byteOrder": "bigEndian",
    "byteEncoding": "raw",
    "members": [
      {
        "type": "Component",
        "ref": "/time",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/raw_lob",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/confidence",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/rssi",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/frequency",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/signedLong"
      },
      {
        "type": "Component",
        "ref": "/time-delta",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/uuid",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/string-utf-8"
      },
      {
        "type": "Component",
        "ref": "/location/lat",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      },
      {
        "type": "Component",
        "ref": "/location/lon",
        "dataType": "http://www.opengis.net/def/dataType/OGC/0/double"
      }
    ]
  }
}